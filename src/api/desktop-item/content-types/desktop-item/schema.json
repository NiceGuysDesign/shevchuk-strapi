{
  "kind": "collectionType",
  "collectionName": "desktop_items",
  "info": {
    "singularName": "desktop-item",
    "pluralName": "desktop-items",
    "displayName": "Desktop Item"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "type": {
      "type": "enumeration",
      "required": true,
      "default": "folder",
      "enum": [
        "folder",
        "image",
        "presentation",
        "AppLink",
        "case"
      ]
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::desktop-item.desktop-item",
      "inversedBy": "children"
    },
    "children": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::desktop-item.desktop-item",
      "mappedBy": "parent"
    },
    "image": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ],
      "description": "For type Case: optional folder cover. If empty, the first screen of Live Preview Link is used."
    },
    "caseViewMode": {
      "type": "enumeration",
      "default": "iframe",
      "enum": [
        "iframe",
        "richBlock"
      ],
      "description": "What to show in the Case window: Live Preview iframe or Case Rich Block. Live / Behance links stay available for both.",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "type"
            },
            "case"
          ]
        }
      }
    },
    "caseRichBlock": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "conditions": {
        "visible": {
          "and": [
            {
              "==": [
                {
                  "var": "type"
                },
                "case"
              ]
            },
            {
              "==": [
                {
                  "var": "caseViewMode"
                },
                "richBlock"
              ]
            }
          ]
        }
      }
    },
    "presentationSlides": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "type"
            },
            "presentation"
          ]
        }
      },
      "component": "presentation.slide",
      "repeatable": true
    },
    "position": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "required": true,
      "default": "top-left",
      "enum": [
        "top-left",
        "top-right",
        "bottom-left",
        "bottom-right"
      ]
    },
    "link": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "type"
            },
            "AppLink"
          ]
        }
      }
    },
    "livePreviewLink": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "description": "Website URL. Used for the Live website button always, and for the iframe when Case View Mode = iframe. If Image is empty, also used as folder icon screenshot.",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "type"
            },
            "case"
          ]
        }
      }
    },
    "behanceLink": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "type"
            },
            "case"
          ]
        }
      }
    }
  }
}
